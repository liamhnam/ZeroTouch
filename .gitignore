# Secrets (Wi-Fi password)
secrets.env

# Large binaries: Windows images, installers, driver packs
*.iso
*.exe
*.msi
drivers/sdio/*
!drivers/sdio/README.md
drivers/inject/**/*
!drivers/inject/README.md

.DS_Store
__pycache__/

# Peripherals: keep the scripts, not the vendor binaries
peripherals/*/**
!peripherals/*/install.ps1
!peripherals/*/README.md
