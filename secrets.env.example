# Copy to secrets.env (ignored by git). make-usb.ps1 turns it into a Wi-Fi profile on the USB drive.
WIFI_SSID=MyNetwork
WIFI_PASSWORD=MyPassword
# WPA2PSK (default) or WPA3SAE
WIFI_AUTH=WPA2PSK

# Tuy chon: Danh sach ma thiet bi ngoai vi muon cai san (vi du: xprinter-q260,hanel-hn212)
# Neu de trong, ZeroTouch se TU DONG quet va nhan dien thiet bi dang cam qua cong USB de cai dat.
PERIPHERALS=

